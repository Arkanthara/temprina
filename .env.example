# Public values, embedded in the static site. Never put a secret in PUBLIC_*.
PUBLIC_SITE_URL=https://example.com
PUBLIC_AUTHOR_NAME=Nom de l’auteur à venir
PUBLIC_CONTACT_EMAIL=
PUBLIC_DEMO_MODE=true
# For native Git deployment, configure these values in Cloudflare Pages too.
# Set only after editorial/legal review; checked by npm run validate:production.
PUBLIC_CONTENT_APPROVED=false
# Optional legacy manual workflow only (not needed for native Git deployment).
# CI secrets, set only in GitHub environment "production":
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# CI variable: CLOUDFLARE_PROJECT_NAME
