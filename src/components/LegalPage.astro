---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import EditorialHeading from './EditorialHeading.astro';
interface Props { page: CollectionEntry<'pages'> }
const { page } = Astro.props;
if (page.data.template !== 'legal') throw new Error('Un modèle legal est requis.');
const { data } = page;
const { Content } = await render(page);
---
<Layout title={data.title} description={data.description}>
  <div class="container legal-page"><p class="eyebrow">{data.eyebrow}</p><h1><EditorialHeading {...data.heading} /></h1>{data.notice && <div class="notice">{data.notice}</div>}<div class="prose"><Content /></div></div>
</Layout>
