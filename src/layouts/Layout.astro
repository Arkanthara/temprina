---
import Icon from '../components/Icon.astro';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site, settings, fillText } from '../lib/site';
import { getLegalInformation } from '../lib/legal';
const { developer } = await getLegalInformation();
const { footerTagline, navigation, images } = settings;
interface Props { title: string; description?: string; image?: string; type?: 'website' | 'article' | 'book'; schema?: Record<string, unknown>; noindex?: boolean }
const { title, description = site.description, image = images.social, type = 'website', schema, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{ href: '/', label: navigation.home }, { href: '/catalogue/', label: navigation.catalogue }, { href: '/auteur/', label: navigation.author }, { href: '/blog/', label: navigation.blog }];
const active = (href: string) => href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(href) || (href === '/catalogue/' && Astro.url.pathname.startsWith('/livres/'));
const authorSchema = { '@context': 'https://schema.org', '@type': 'Person', '@id': new URL('/auteur/#auteur', Astro.site).href, name: site.author, url: new URL('/auteur/', Astro.site).href, jobTitle: settings.identity.jobTitle };
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.author}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101f1d" />
    {(site.demo || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={images.logo.src} type={images.logo.type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(schema || authorSchema).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{settings.skipContent}</a>
    {site.demo && <div class="demo-bar">{settings.demo.heading} <span aria-hidden="true"><Icon name="spark" /></span> {settings.demo.description}</div>}
    <header class="site-header">
      <a href="/" class="brand" aria-label={fillText(navigation.homeAccessibleLabel, { author: site.author })}><Logo /><span>{site.author}<small>{settings.headerSubtitle}</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation" hidden>{navigation.menu} <span aria-hidden="true"><Icon name="menu" /></span></button>
      <nav id="navigation" aria-label={navigation.label}>
        {nav.map(({ href, label }) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
        <a href="/contact/" class="nav-contact" aria-current={active('/contact/') ? 'page' : undefined}>{navigation.contact} <span aria-hidden="true"><Icon name="arrow-up" /></span></a>
      </nav>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href="/" class="brand"><Logo /><span>{site.author}<small>{footerTagline}</small></span></a><p class="footer-message editorial-lines">{settings.footerMessage}</p><a class="text-link" href="/contact/">{navigation.contact} <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} · {site.author}</span><div><a href="/mentions-legales/">{navigation.legal}</a><a href="/confidentialite/">{navigation.privacy}</a></div><span>{settings.footerCredit} <span class="gold" aria-hidden="true"><Icon name="spark" /></span></span></div>
      {developer.showInFooter && developer.name && <p class="developer-credit">{developer.role} · {developer.url ? <a href={developer.url}>{developer.name}</a> : <span>{developer.name}</span>}</p>}
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      if (toggle && navigation) {
        toggle.hidden = false;
        document.documentElement.classList.add('has-js');
        toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            toggle.setAttribute('aria-expanded', 'false'); toggle.focus();
          }
        });
        navigation.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) toggle.setAttribute('aria-expanded', 'false'); });
      }
    </script>
  </body>
</html>
