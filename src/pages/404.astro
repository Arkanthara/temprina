---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import EditorialHeading from '../components/EditorialHeading.astro';
import { getPage } from '../lib/pages';
const { data } = await getPage('404', 'error');
---
<Layout title={data.title} description={data.description} noindex>
  <section class="lost-page container"><p class="eyebrow">{data.eyebrow}</p><span class="lost-star" aria-hidden="true"><Icon name="spark" /></span><h1><EditorialHeading {...data.heading} /></h1><p class="editorial-lines">{data.lead}</p><div class="lost-actions"><a class="button" href="/">{data.homeLabel} <Icon name="arrow-up" /></a><a class="text-link" href="/catalogue/">{data.catalogueLabel} <Icon name="arrow-right" /></a></div></section>
</Layout>
