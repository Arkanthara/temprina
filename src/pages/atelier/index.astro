---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CreationCard from '../../components/CreationCard.astro';
import AtelierInvitation from '../../components/AtelierInvitation.astro';
import hero from '../../assets/atelier/aurore.png';
import drawing from '../../assets/atelier/herbier.svg';
import { getAtelier, getCreations } from '../../lib/atelier';
const atelier = await getAtelier();
const creations = await getCreations('couture');
---
<Layout title="La poésie prend forme" description={atelier.description} universe="atelier">
  <section class="atelier-hero" aria-labelledby="atelier-title">
    <Image class="atelier-hero-image" src={hero} alt="Robe de conte de démonstration, brodée de fleurs et drapée de tulle, dans un atelier lumineux." widths={[640, 1024, 1536]} sizes="100vw" width={1536} height={1024} format="webp" loading="eager" fetchpriority="high" />
    <div class="container atelier-hero-inner"><p class="eyebrow"><span class="rule"></span> COUTURE FÉÉRIQUE & ILLUSTRATION</p><h1 id="atelier-title">Un peu de rêve,<br />beaucoup de<br /><em>savoir-faire.</em></h1><p>Des étoffes qui racontent. Des dessins qui enchantent.<br />Bienvenue là où l’imaginaire prend forme.</p><a class="button" href="/atelier/couture/">Découvrir les créations <Icon name="arrow-up" /></a><a class="atelier-hero-link" href="/atelier/dessins/">Explorer les dessins <Icon name="arrow-right" /></a></div>
    <div class="atelier-hero-caption"><Icon name="spark" /> DE MES MAINS À VOTRE IMAGINAIRE</div>
  </section>
  <section class="atelier-introduction container"><span class="atelier-small-mark" aria-hidden="true"><img src="/images/atelier-logo.svg" width="80" height="80" alt="" /></span><p>{atelier.introduction}</p><span class="handwritten">{atelier.signature}</span></section>
  <section class="section container atelier-collection">
    <div class="section-heading"><div><p class="eyebrow">LE VESTIAIRE DES CONTES</p><h2>Cousu de <em>merveilleux.</em></h2></div><a class="text-link" href="/atelier/couture/">Toute la couture <Icon name="arrow-up" /></a></div>
    {creations.length ? <div class="creations-grid">{creations.slice(0, 3).map(creation => <CreationCard creation={creation} />)}</div> : <p class="empty-state">Les premières créations seront dévoilées ici prochainement.</p>}
  </section>
  <section class="drawing-feature"><div class="container drawing-feature-inner"><div class="drawing-feature-art"><Image src={drawing} alt="Illustration botanique de démonstration : fleurs sauvages mauves et feuillages sur papier ivoire." width={600} height={750} format="svg" /><span>EXPLORATIONS SUR PAPIER</span></div><div><p class="eyebrow">LE MÊME IMAGINAIRE, UN AUTRE GESTE</p><h2>Il y a aussi<br /><em>le trait.</em></h2><p>Avant le fil, parfois, il y a le crayon. Et parfois, le dessin devient une histoire à lui seul.</p><p>Un univers d’illustrations, de botanique rêvée et de personnages à découvrir. Vous imaginez un dessin personnel ? La créatrice vous écoute.</p><a class="text-link" href="/atelier/dessins/">Entrer dans la galerie <Icon name="arrow-up" /></a></div></div></section>
  <section class="atelier-process container"><p class="eyebrow">UNE CRÉATION, UNE RENCONTRE</p><h2>Du premier mot<br /><em>aux derniers détails.</em></h2><div class="process-steps"><article><span>01</span><h3>Vous racontez.</h3><p>Une envie, une occasion, des images qui vous inspirent. Tout commence par un échange.</p></article><article><span>02</span><h3>On imagine.</h3><p>La créatrice échange avec vous sur l’allure, les matières ou le style de votre dessin.</p></article><article><span>03</span><h3>Le rêve prend forme.</h3><p>Les possibilités, le calendrier et le devis se précisent ensemble, avant tout engagement.</p></article></div></section>
  <AtelierInvitation />
</Layout>
