---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import forest from '../assets/foret-enchantee.png';
import { site } from '../lib/site';
import { getPage } from '../lib/pages';
const page = await getPage('auteur', 'author');
const { Content } = await render(page);
const { data } = page;
---
<Layout title={data.title} description={data.description}>
  <PageHeading {...data} />
  <section class="container author-page" aria-labelledby="biographie"><div class="author-illustration"><Image src={forest} alt={data.imageAlt} width={700} format="webp" /><span>{data.imageCaption}</span></div><div class="prose"><p class="eyebrow">{site.author}</p><h2 id="biographie">{data.biographyTitle}</h2>{data.biography.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href="/catalogue/">{data.linkLabel} <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div></section>
  <section class="container author-presentation prose"><Content /></section>
</Layout>
