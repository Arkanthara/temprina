---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { site } from '../lib/site';
import { getPage } from '../lib/pages';
const page = await getPage('auteur', 'author');
const { Content } = await render(page);
const { data } = page;
---
<Layout title={data.title} description={data.description}>
  <PageHeading {...data} />
  <section class="container author-page" id="auteur" aria-labelledby="biographie">
    <div class="author-visuals">
      <figure class="author-illustration"><Image src={data.image} alt={data.imageAlt} width={700} format="webp" /><figcaption>{data.imageCaption}</figcaption></figure>
      {data.portrait.enabled && <figure class="author-portrait">
        {data.portrait.image
          ? <Image src={data.portrait.image} alt={data.portrait.alt} width={240} height={240} fit="cover" position={data.portrait.position} format="webp" class="author-portrait-photo" />
          : <div class="author-portrait-placeholder"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><circle cx="32" cy="23" r="10" /><path d="M12 56c0-13 8-21 20-21s20 8 20 21" /></svg><span>{data.portrait.placeholder}</span></div>}
        {data.portrait.caption && <figcaption class="editorial-lines">{data.portrait.caption}</figcaption>}
      </figure>}
    </div>
    <div class="prose"><p class="eyebrow">{site.author}</p><h2 id="biographie">{data.biographyTitle}</h2>{data.biography.map(paragraph => <p>{paragraph}</p>)}<a class="text-link" href="/catalogue/">{data.linkLabel} <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div>
  </section>
  <section class="container author-presentation prose"><Content /></section>
</Layout>
