---
import Icon from '../../components/Icon.astro';
import { render } from 'astro:content';
import { getPosts } from '../../lib/collections';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { formatDate, settings, fillText } from '../../lib/site';
import { getPage } from '../../lib/pages';
const page = await getPage('blog', 'blog');
const { data } = page;
const { Content } = await render(page);
const posts = await getPosts();
---
<Layout title={data.title} description={data.description}>
  <PageHeading {...data} />
  <section class="container journal-list" aria-label={data.listLabel}>{page.body?.trim() && <div class="prose"><Content /></div>}{posts.map((post) => <article class="journal-row"><div><p class="book-meta">{post.data.category} · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.readingMinutes !== undefined && <> · {fillText(settings.blog.readingShortLabel, { minutes: post.data.readingMinutes })}</>}</p><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p>{post.data.demo && <span class="demo-label">{data.demoLabel}</span>}</div><a href={`/blog/${post.id}/`} class="round-link" aria-label={fillText(data.readLabel, { title: post.data.title })}><Icon name="arrow-up" /></a></article>)}{!posts.length && <p class="empty-state">{data.empty}</p>}</section>
</Layout>
