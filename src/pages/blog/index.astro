---
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/PageHeading.astro';
import { isVisible, formatDate, settings, fillText } from '../../lib/site';
import { getPage } from '../../lib/pages';
const { data } = await getPage('blog', 'blog');
const posts = (await getCollection('blog', isVisible)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title={data.title} description={data.description}>
  <PageHeading {...data} />
  <section class="container journal-list" aria-label={data.listLabel}>{posts.map((post,index) => <article class="journal-row"><span class="journal-number" aria-hidden="true">0{index+1}</span><div><p class="book-meta">{post.data.category} · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {fillText(settings.blog.readingShortLabel, { minutes: post.data.readingMinutes })}</p><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p>{post.data.demo && <span class="demo-label">{data.demoLabel}</span>}</div><a href={`/blog/${post.id}/`} class="round-link" aria-label={data.readLabel.replaceAll('{title}', post.data.title)}><Icon name="arrow-up" /></a></article>)}{!posts.length && <p class="empty-state">{data.empty}</p>}</section>
</Layout>
