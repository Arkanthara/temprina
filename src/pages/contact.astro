---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import { render } from 'astro:content';
import { getPage } from '../lib/pages';
import { site } from '../lib/site';
const page = await getPage('contact', 'contact');
const { data } = page;
const { Content } = await render(page);
---
<Layout title={data.title} description={data.description}>
  <PageHeading {...data} />
  <section class="container contact-page"><div class="prose"><Content /><div class="contact-detail"><span class="eyebrow">{data.details.label}</span>{site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <p>{data.details.unavailable}</p>}</div><p class="subtle">{data.details.privacy} <a href="/confidentialite/">{data.details.privacyLabel}</a></p></div>
  <div class="contact-panel"><h2>{data.panel.title}</h2><p data-selected-book data-template={data.form.selectedBook} hidden></p>
    {site.email ? <><form data-contact data-email={site.email} data-book-subject={data.form.bookSubject} data-book-message={data.form.bookMessage} data-status={data.form.status} hidden><label for="subject">{data.form.subjectLabel}</label><input id="subject" name="subject" required maxlength="180" value={data.form.subjectDefault} /><label for="message">{data.form.messageLabel}</label><textarea id="message" name="message" rows="7" required maxlength="5000" placeholder={data.form.messagePlaceholder}></textarea><p class="subtle">{data.form.hint}</p><button class="button" type="submit">{data.form.submitLabel} <span aria-hidden="true"><Icon name="arrow-up" /></span></button><p role="status" data-contact-status></p></form><noscript><p>{data.form.noScript}</p></noscript></> : <div class="contact-pending"><span aria-hidden="true"><Icon name="spark" /></span><h3>{data.panel.pendingTitle}</h3><p>{data.panel.pendingText}</p><a href="/catalogue/" class="text-link">{data.panel.pendingLink} <Icon name="arrow-up" /></a></div>}
  </div></section>
  <script>
    const book = new URLSearchParams(location.search).get('livre')?.slice(0,150);
    const selected = document.querySelector<HTMLElement>('[data-selected-book]');
    const subject = document.querySelector<HTMLInputElement>('#subject');
    const message = document.querySelector<HTMLTextAreaElement>('#message');
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    if (book) {
      if (selected) { selected.hidden = false; selected.textContent = (selected.dataset.template || '').replaceAll('{book}', () => book); }
      if (subject) subject.value = (form?.dataset.bookSubject || '').replaceAll('{book}', () => book).slice(0, 180);
      if (message) message.value = (form?.dataset.bookMessage || '').replaceAll('{book}', () => book).slice(0, 5000);
    }
    if (form) form.hidden = false;
    form?.addEventListener('submit',event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const values = new FormData(form);
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(values.get('subject')))}&body=${encodeURIComponent(String(values.get('message')))}`;
      const status = document.querySelector<HTMLElement>('[data-contact-status]');
      if (status) status.textContent = form.dataset.status || '';
    });
  </script>
</Layout>
