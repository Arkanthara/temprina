---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import Logo from '../components/Logo.astro';
import forest from '../assets/foret-enchantee.png';
import { isVisible, formatDate } from '../lib/site';
const books = (await getCollection('books', isVisible)).sort((a,b) => Number(b.data.featured)-Number(a.data.featured) || b.data.publicationDate.valueOf()-a.data.publicationDate.valueOf()).slice(0,3);
const posts = (await getCollection('blog', isVisible)).sort((a,b) => b.data.date.valueOf()-a.data.date.valueOf()).slice(0,2);
---
<Layout title="Des histoires au-delà du réel">
  <section class="hero" aria-labelledby="hero-title">
    <Image src={forest} alt="" widths={[640, 1024, 1536]} sizes="100vw" width={1536} height={1024} format="webp" loading="eager" fetchpriority="high" class="hero-image" />
    <div class="hero-content">
      <p class="eyebrow"><span class="rule"></span> ROMANS & MONDES IMAGINAIRES</p>
      <h1 id="hero-title">Il est des mondes<br />qui n’attendent<br />que <em>vous.</em></h1>
      <p class="hero-description">Au détour d’une page, la forêt murmure.<br />La magie s’éveille. Et l’aventure commence.</p>
      <a href="/catalogue/" class="button">Explorer les romans <span aria-hidden="true"><Icon name="arrow-up" /></span></a>
      <a href="/auteur/" class="hero-secondary">Rencontrer l’auteur <span aria-hidden="true"><Icon name="arrow-right" /></span></a>
    </div>
    <div class="hero-caption"><span aria-hidden="true"><Icon name="spark" /></span> L’IMAGINAIRE EST UN LIEU OÙ L’ON SE RETROUVE.</div>
    <a class="scroll-cue" href="#romans" aria-label="Découvrir les romans plus bas">DÉFILER <span aria-hidden="true"><Icon name="arrow-down" /></span></a>
  </section>
  <section class="section container" id="romans">
    <div class="section-heading"><div><p class="eyebrow">DES PORTES VERS L’AILLEURS</p><h2>Choisissez votre <em>voyage.</em></h2></div><a class="text-link" href="/catalogue/">Tout le catalogue <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div>
    <div class="books-grid">{books.map(book => <BookCard book={book} />)}</div>
    {!books.length && <p class="empty-state">Les premiers romans seront dévoilés prochainement.</p>}
  </section>
  <section class="author-band"><div class="container author-band-inner"><div class="ornament" aria-hidden="true"><Logo /></div><div><p class="eyebrow">DERRIÈRE LES MOTS</p><h2>Tout commence<br />par un <em>« et si… »</em></h2><p>Et si les arbres gardaient nos souvenirs ? Si les étoiles avaient leurs secrets ? Entrez dans un univers où l’invisible prend vie, et où chaque histoire ouvre un nouveau chemin.</p><a href="/auteur/" class="text-link">À la rencontre de l’auteur <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div></div></section>
  <section class="section container">
    <div class="section-heading"><div><p class="eyebrow">LE CARNET DE LECTURE</p><h2>Au coin du <em>feu.</em></h2><p>Des lectures, des réflexions et le plaisir de prolonger l’histoire.</p></div><a href="/blog/" class="text-link">Tous les articles <span aria-hidden="true"><Icon name="arrow-up" /></span></a></div>
    <div class="journal-grid">{posts.map((post,index) => <article class="journal-card"><div class={`journal-symbol symbol-${index}`} aria-hidden="true"><Icon name={index === 0 ? "moon" : "spark"} /></div><div><div class="book-meta">{post.data.category} · {formatDate(post.data.date)}</div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}/`}>Lire l’article <span aria-hidden="true"><Icon name="arrow-up" /></span></a>{post.data.demo && <p class="demo-label">Article de démonstration</p>}</div></article>)}</div>
    {!posts.length && <p class="empty-state">Le carnet de lecture ouvrira bientôt ses pages.</p>}
  </section>
  <section class="contact-strip container"><span aria-hidden="true"><Icon name="spark" /></span><div><h2>Les histoires créent des liens.</h2><p>Un livre vous appelle ? Une question, un mot à partager ?</p></div><a href="/contact/" class="button button-outline">Écrivons-nous <span aria-hidden="true"><Icon name="arrow-up" /></span></a></section>
</Layout>
