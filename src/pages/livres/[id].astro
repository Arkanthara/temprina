---
import Icon from '../../components/Icon.astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Share from '../../components/Share.astro';
import BookFollowUp from '../../components/BookFollowUp.astro';
import { isVisible, formatDate, site } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('books', isVisible)).map(book => ({ params: { id: book.id }, props: { book } })); }
const { book } = Astro.props;
const { Content } = await render(book);
const cover = await getImage({ src: book.data.cover, width: 600, format: 'jpg' });
const eyebrow = [book.data.genre, book.data.series, book.data.volume && `Tome ${book.data.volume}`].filter(Boolean).join(' · ');
const hasContent = Boolean(book.body?.trim());
const followedBy = book.data.followedBy;
const description = book.data.description || `Découvrez ${book.data.title}, un ${followedBy ? 'livre' : 'roman'} de ${site.author}, publié le ${formatDate(book.data.publicationDate)}.`;
const title = [book.data.title, book.data.subtitle || (book.data.volume && `Tome ${book.data.volume}`), followedBy && `suivi de ${followedBy.title}`].filter(Boolean).join(' — ');
const schema = {
  '@context': 'https://schema.org', '@type': 'Book', name: book.data.title,
  ...(book.data.description && { description: book.data.description }),
  author: { '@type': 'Person', name: site.author, '@id': new URL('/auteur/#auteur', Astro.site).href },
  datePublished: book.data.publicationDate.toISOString().slice(0,10), inLanguage: 'fr',
  ...(book.data.genre && { genre: book.data.genre }),
  image: new URL(cover.src, Astro.site).href, url: new URL(Astro.url.pathname, Astro.site).href,
  ...(book.data.isbn && { isbn: book.data.isbn }),
  ...(book.data.publisher && { publisher: { '@type': 'Organization', name: book.data.publisher } }),
  ...(followedBy && { hasPart: {
    '@type': 'CreativeWork', name: followedBy.title,
    ...(followedBy.description && { description: followedBy.description }),
    ...(followedBy.summary && { abstract: followedBy.summary }),
  } }),
};
---
<Layout title={title} description={description} image={cover.src} type="book" schema={schema}>
  <div class="container book-detail">
    <a href="/catalogue/" class="back-link"><Icon name="arrow-left" /> Tous les romans</a>
    <div class="book-detail-grid"><div class="detail-cover"><Image src={book.data.cover} alt={book.data.coverAlt || `Couverture de ${book.data.title}`} width={600} height={900} loading="eager" />{book.data.demo && <p class="demo-label">Couverture et roman de démonstration</p>}</div>
      <div class="book-info">{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>{book.data.title}</h1>{book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}{followedBy && <BookFollowUp title={followedBy.title} />}<p class="byline">Un {followedBy ? 'livre' : 'roman'} de {site.author}</p>
        {book.data.description && <p class="book-description">{book.data.description}</p>}
        {hasContent && <div class="prose">{followedBy && <h2>{book.data.title}</h2>}<Content /></div>}
        {followedBy && (followedBy.description || followedBy.summary) && <section class="book-second-story" aria-labelledby="second-story-title">
          <h2 id="second-story-title">{followedBy.title}</h2>
          {followedBy.description && <p class="book-description">{followedBy.description}</p>}
          {followedBy.summary && <div class="prose">{followedBy.summary.split(/\r?\n\s*\r?\n/).map(paragraph => <p>{paragraph}</p>)}</div>}
        </section>}
        <dl class="book-facts"><div><dt>Publication</dt><dd><time datetime={book.data.publicationDate.toISOString()}>{formatDate(book.data.publicationDate)}</time></dd></div>{book.data.genre && <div><dt>Genre</dt><dd>{book.data.genre}</dd></div>}{book.data.series && <div><dt>Série</dt><dd>{book.data.series}</dd></div>}{book.data.volume && <div><dt>Tome</dt><dd>{book.data.volume}</dd></div>}</dl>
        <div class="purchase-note"><h2>Cette histoire vous appelle ?</h2><p>Contactez directement l’auteur pour connaître les disponibilités et vous procurer ce livre.</p><a class="button" href={`/contact/?livre=${encodeURIComponent(book.data.title)}`}>Contacter l’auteur pour ce livre <span aria-hidden="true"><Icon name="arrow-up" /></span></a>{book.data.demo && <p class="demo-label">Exemple fictif · Ce livre n’est pas disponible à l’achat.</p>}</div>
        <Share title={followedBy ? title : book.data.title} />
      </div>
    </div>
  </div>
</Layout>
